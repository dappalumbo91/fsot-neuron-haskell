  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
      fsot-neuron-haskell
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite fsot-neuron-haskell-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
      fsot-neuron-haskell