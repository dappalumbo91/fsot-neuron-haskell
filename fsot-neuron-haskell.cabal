cabal-version:      3.0
name:               fsot-neuron-haskell
version:            0.3.0.0
synopsis:           FSOT neural mind - full Phase A twin of fsot-neuron-zig
description:        Unequivocable Phase A + continuous organism twin.
license:            Apache-2.0
license-file:       LICENSE
author:             FSOT
maintainer:         local
category:           Science
build-type:         Simple
extra-source-files:
  README.md
  docs/*.md
  docs/*.txt
  data/**/*

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat -Wno-unused-imports
  build-depends:
      base >= 4.14 && < 5
    , containers
    , text
    , bytestring
    , directory
    , filepath
    , time

